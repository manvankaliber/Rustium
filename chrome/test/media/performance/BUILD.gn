import("//build/config/python.gni")
import("//build/config/vpython.gni")

python_library("common") {
  testonly = true
  data = [
    "camera.py",
    "cast_starter.html",
    "remoting_video.html",
    "repeating_log.py",
    "server.py",
    "video.html",
    "video_analyzer.py",
    "common.py",
    "cros_setup.py",
    "media_metrics.py",
    "perf_config.py",
    "remote_transport.py",
    "senders.py",
  ]
}

python_library("videostack_performance_test") {
  testonly = true
  pydeps_file = "videostack_performance_test.pydeps"
  data = [
           "//build/util/lib/proto",

           "//third_party/crossbench/",
         ] + vpython_spec_files
  deps = [ ":common" ]
}

python_library("openscreen_cast_performance_test") {
  testonly = true
  pydeps_file = "openscreen_cast_performance_test.pydeps"
  data = [
           "//build/util/lib/proto",

           "//third_party/crossbench/",
         ] + vpython_spec_files
  deps = [ ":common" ]
}

python_library("openscreen_remoting_performance_test") {
  testonly = true
  pydeps_file = "openscreen_remoting_performance_test.pydeps"
  data = [
           "//build/util/lib/proto",

           "//third_party/catapult/third_party/gsutil/",
         ] + vpython_spec_files
  deps = [ ":common" ]
}

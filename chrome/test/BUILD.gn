    # Other browser_tests in this target (e.g. the mac
    # render_view_context_menu browsertest) include spellchecker headers,
    # and spellchecker:browser_tests contributes its own browser test files
    # to this binary.
    deps += [ "//chrome/browser/spellchecker:browser_tests" ]
  }

  if (enterprise_data_controls) {
    deps += [ "//chrome/browser/enterprise/data_controls:browser_tests" ]
  }

  if (enable_webui_generate_code_cache) {
    deps += [ "//ui/webui/resources:code_cache_resources" ]
  }


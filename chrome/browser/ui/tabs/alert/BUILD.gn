assert(is_win || is_mac || is_linux)

import("//chrome/common/features.gni")

source_set("tab_alert") {
  public = [
    "child_tab_alert_helper.h",
    "tab_alert_controller.h",
    "tab_alert_icon.h",
  ]

  public_deps = [
    "//base",
    "//chrome/browser/contextual_tasks",
    "//chrome/browser/ui/tabs:tabs_public",
    "//chrome/browser/vr",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base/unowned_user_data",
  ]

  deps = [
    "//chrome/browser/media/webrtc",
    "//chrome/browser/ui/color:color_headers",
  ]
}

source_set("impl") {
  sources = [
    "child_tab_alert_helper.cc",
    "tab_alert_controller.cc",
    "tab_alert_icon.cc",
  ]

  deps = [
    ":tab_alert",
    "//chrome/app/vector_icons",
    "//chrome/browser/contextual_tasks",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/ui:layout_constants",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:color_headers",
    "//chrome/common:chrome_features",
    "//components/contextual_tasks/public:feature_list",
    "//components/tabs:public",
    "//components/vector_icons",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "tab_alert_controller_unittest.cc" ]

  deps = [
    ":impl",
    ":tab_alert",
    "//chrome/browser/contextual_tasks",
    "//chrome/browser/media/webrtc",
    "//chrome/browser/permissions/system",
    "//chrome/browser/ui:recently_audible_helper",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/vr",
    "//chrome/test:test_support",
    "//chrome/test/base:testing_browser_process",
    "//components/contextual_tasks/public:feature_list",
    "//components/tabs:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

source_set("interactive_ui_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "tab_alert_controller_interactive_uitest.cc" ]

  deps = [
    ":impl",
    ":tab_alert",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_web_contents_delegate",
    "//chrome/browser/ui/tabs:test_support",
    "//chrome/test:test_support",
    "//components/tabs:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

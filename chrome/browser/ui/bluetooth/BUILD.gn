assert(is_win || is_mac || is_linux)

source_set("bluetooth") {
  sources = [ "bluetooth_dialogs.h" ]

  public_deps = [
    "//components/permissions",
    "//content/public/browser",
  ]

  sources += [ "chrome_bluetooth_chooser_controller.h" ]
}

source_set("impl") {
  deps = [ "//chrome/browser/ui/browser_window" ]
  sources = []

  sources += [ "chrome_bluetooth_chooser_controller.cc" ]

  deps += [
    ":bluetooth",
    "//chrome/browser/chooser_controller",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui:scoped_tabbed_browser_displayer",
    "//chrome/common",
    "//components/permissions:permissions_common",
    "//components/strings:components_strings_grit",
  ]
}

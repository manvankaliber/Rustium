    deps += [
      "//chrome/browser/ui/pdf/infobar",
      "//chrome/browser/ui/startup/default_browser_prompt/pin_infobar",
    ]

    if (enable_extensions_core) {
      deps += [ "//chrome/browser/ui/search_engines" ]
    }
  }

  if (is_win || is_mac || is_linux) {
    deps += [
      "//chrome/browser/download/bubble",
      "//chrome/browser/ui/views/profiles:profile_customization_bubble_sync_controller",
      "//chrome/browser/ui/views/session_restore_infobar",
    ]
  }


  deps += [ "//chrome/browser/download/bubble" ]


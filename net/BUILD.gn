# Separated from the net target to isolate the dependency on the generated
# Pure header target containing data structures for Chrome Root Store and EV
# Root CA metadata. Separated so that both component("net") and the generated
# data source_set can depend on it without circular includes.
source_set("chrome_root_store_types") {
  visibility = [ ":*" ]
  sources = [ "cert/internal/chrome_root_store_data.h" ]
  if (chrome_key_pinning_supported) {
    sources += [
      "cert/key_pinning_state_chrome_data.h",
      "http/transport_security_state_pins_source.h",
    ]
  }
  public_deps = [ "//base" ]
}

# Encapsulates the generated chrome-root-store-inc.cc, signer-set-inc.cc, and
# chrome-ev-roots-inc.cc files. Isolating these in a separate source_set
# prevents component("net")'s 1,000+ source files from waiting on
# root_store_tool and signer_set_tool generation actions (inputdeps), while
# avoiding any circular includes (no allow_circular_includes_from required).
source_set("chrome_root_store_data") {
  visibility = [ ":*" ]
  public = []
  configs += [ ":net_internal_config" ]
  sources = []
  deps = [
    ":chrome_root_store_types",
    "//base",
  ]
  if (chrome_root_store_supported) {
    deps += [ "//net/data/ssl/chrome_root_store:gen_root_store_inc" ]

    sources += [ "cert/ev_root_ca_metadata_data.cc" ]
  }
  if (chrome_root_store_supported) {
    sources += [ "cert/internal/trust_store_chrome_data.cc" ]
    deps += [ "//net/data/ssl/chrome_root_store:gen_signer_set_inc" ]
  }
  if (chrome_key_pinning_supported) {
    sources += [ "cert/key_pinning_state_chrome_data.cc" ]
    deps += [ "//net/http:generate_transport_security_state_pins" ]
  }
}


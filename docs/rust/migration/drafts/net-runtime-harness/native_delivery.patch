+def execution_temporary_root(snapshot, parent):
+    """Keep nested Windows fixture paths short and outside immutable inputs."""
+    snapshot = Path(snapshot).resolve()
+    parent = Path(parent).resolve()
+    require(not parent.is_relative_to(snapshot) and not snapshot.is_relative_to(parent),
+            'Temporary parent overlaps sealed snapshot')
+    # Reserve space for the unique run name and nested native fixture paths.
+    require(len(str(parent)) <= 48, 'Temporary parent must be at most 48 characters')
+    parent.mkdir(parents=True, exist_ok=True)
+    return Path(tempfile.mkdtemp(prefix='net-', dir=parent)).resolve()
+

   }
 
+  // Counts entries above and at `priority` without visiting queue values.
+  std::pair<size_t, size_t> InsertionBucketCounts(Priority priority) const {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    DCHECK_LT(priority, lists_.size());
+    size_t higher = 0;
+    for (size_t i = static_cast<size_t>(priority) + 1; i < lists_.size(); ++i)
+      higher += lists_[i].size();
+    return {higher, lists_[priority].size()};
+  }
+

diff --git a/net/socket/transport_assignment_original_actions.h b/net/socket/transport_assignment_original_actions.h
new file mode 100644
index 0000000000000000000000000000000000000000..5b82ab052059fd429d52a1d9d92d101ec6cb3aa5
--- /dev/null
+++ b/net/socket/transport_assignment_original_actions.h
@@ -0,0 +1,39 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Independent original-loop oracle; see source-identity.json for source pins.
+#ifndef NET_SOCKET_TRANSPORT_ASSIGNMENT_ORIGINAL_ACTIONS_H_
+#define NET_SOCKET_TRANSPORT_ASSIGNMENT_ORIGINAL_ACTIONS_H_
+
+#include <stddef.h>
+
+#include <limits>
+#include <vector>
+
+namespace transport_assignment_original {
+inline constexpr size_t kNone = std::numeric_limits<size_t>::max();
+inline constexpr size_t kFront = kNone - 1;
+
+// The hole represents the just-inserted request or the request whose job was
+// released by RemoveUnboundJob. Other entries are in original queue order.
+inline size_t ChooseHole(const std::vector<bool>& jobs, size_t hole,
+                         size_t unassigned_jobs) {
+  if (unassigned_jobs)
+    return kFront;
+  size_t next = hole + 1;
+  if (next == jobs.size() || !jobs[next])
+    return kNone;
+  size_t current = next;
+  while (current + 1 < jobs.size() && jobs[current + 1])
+    ++current;
+  return current;
+}
+inline size_t ChooseRelease(const std::vector<bool>& jobs) {
+  size_t i = 0;
+  while (i < jobs.size() && jobs[i])
+    ++i;
+  return i == jobs.size() ? kNone : i;
+}
+}  // namespace transport_assignment_original
+#endif  // NET_SOCKET_TRANSPORT_ASSIGNMENT_ORIGINAL_ACTIONS_H_
diff --git a/net/socket/transport_assignment_rust.rs b/net/socket/transport_assignment_rust.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5d7d8694fcc7a7e5839fb9f6c713f57ddae3a7ce
--- /dev/null
+++ b/net/socket/transport_assignment_rust.rs
@@ -0,0 +1,45 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+const NONE: usize = usize::MAX;
+const FRONT: usize = usize::MAX - 1;
+const INVALID: usize = usize::MAX - 2;
+
+// The queue has exactly one unassigned hole. `assigned` excludes that hole,
+// even when the corresponding removed job is still temporarily in jobs_.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_transport_assignment_hole(
+    rank: usize,
+    request_count: usize,
+    assigned: usize,
+    unassigned: usize,
+) -> usize {
+    if request_count >= INVALID || rank >= request_count || assigned >= request_count {
+        return INVALID;
+    }
+    if unassigned != 0 {
+        FRONT
+    } else if rank < assigned {
+        assigned
+    } else {
+        NONE
+    }
+}
+
+// Called after the new/released job has been pushed to the native deque.
+#[unsafe(no_mangle)]
+pub extern "C" fn rust_transport_assignment_release(
+    request_count: usize,
+    assigned: usize,
+    unassigned: usize,
+) -> usize {
+    if request_count >= INVALID || assigned > request_count || unassigned == 0 {
+        return INVALID;
+    }
+    if assigned < request_count {
+        assigned
+    } else {
+        NONE
+    }
+}
diff --git a/net/socket/transport_assignment_unittest.cc b/net/socket/transport_assignment_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c6e8c35504eaab36629f3dc3f4dbb18611754000
--- /dev/null
+++ b/net/socket/transport_assignment_unittest.cc
@@ -0,0 +1,79 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/socket/transport_assignment_ffi.h"
+
+#include <stddef.h>
+
+#include <vector>
+
+#include "net/socket/transport_assignment_original_actions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+namespace {
+
+using transport_assignment_original::ChooseHole;
+using transport_assignment_original::ChooseRelease;
+
+TEST(TransportAssignmentPolicyTest, InsertedHoleMatchesOriginalLoop) {
+  for (size_t count = 0; count <= 8; ++count) {
+    for (size_t assigned = 0; assigned <= count; ++assigned) {
+      for (size_t hole = 0; hole <= count; ++hole) {
+        std::vector<bool> jobs;
+        for (size_t i = 0; i < count; ++i)
+          jobs.push_back(i < assigned);
+        jobs.insert(jobs.begin() + hole, false);
+        for (size_t unassigned = 0; unassigned <= 2; ++unassigned) {
+          if (unassigned && assigned != count)
+            continue;
+          EXPECT_EQ(ChooseHole(jobs, hole, unassigned),
+                    TransportAssignmentHole(hole, jobs.size(), assigned,
+                                            unassigned));
+        }
+      }
+    }
+  }
+}
+
+TEST(TransportAssignmentPolicyTest, RemovedAssignedJobMatchesOriginalLoop) {
+  for (size_t count = 1; count <= 8; ++count) {
+    for (size_t old_assigned = 1; old_assigned <= count; ++old_assigned) {
+      for (size_t hole = 0; hole < old_assigned; ++hole) {
+        std::vector<bool> jobs(count, false);
+        for (size_t i = 0; i < old_assigned; ++i)
+          jobs[i] = true;
+        jobs[hole] = false;
+        for (size_t unassigned = 0; unassigned <= 2; ++unassigned) {
+          if (unassigned && old_assigned != count)
+            continue;
+          EXPECT_EQ(ChooseHole(jobs, hole, unassigned),
+                    TransportAssignmentHole(hole, count, old_assigned - 1,
+                                            unassigned));
+        }
+      }
+    }
+  }
+}
+
+TEST(TransportAssignmentPolicyTest, AddedOrReleasedJobMatchesOriginalLoop) {
+  for (size_t count = 0; count <= 8; ++count) {
+    for (size_t assigned = 0; assigned <= count; ++assigned) {
+      std::vector<bool> jobs(count, false);
+      for (size_t i = 0; i < assigned; ++i)
+        jobs[i] = true;
+      EXPECT_EQ(ChooseRelease(jobs),
+                TransportAssignmentRelease(count, assigned, 1));
+      if (assigned == count) {
+        EXPECT_EQ(ChooseRelease(jobs),
+                  TransportAssignmentRelease(count, assigned, 2));
+      }
+    }
+  }
+  EXPECT_EQ(kTransportAssignmentInvalid, TransportAssignmentHole(0, 0, 0, 0));
+  EXPECT_EQ(kTransportAssignmentInvalid, TransportAssignmentRelease(0, 0, 0));
+}
+
+}  // namespace
+}  // namespace net

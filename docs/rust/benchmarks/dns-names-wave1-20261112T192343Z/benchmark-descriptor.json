{
  "module": "dns-names",
  "source": "dns-names",
  "label": "DNS name utilities",
  "measurement": "Same-process paired public APIs including Rust FFI, per-label cursor callbacks, input adaptation, output allocation/copying and destruction. Inputs constructed and warmed outside timing; no DNS query, network I/O or disk I/O. Each pair times 20,000 operations per implementation; 20 randomized-order pairs, seed 20261112. Checksums and timing calls included for both implementations; printing and ICU initialization excluded.",
  "baseline": "Frozen original dns_names_util.cc and ASCII comparator, with frozen hostname, localhost and IP wrapper policy; URL IP parsing and URL/IDNA canonicalization remain shared external services.",
  "groups": [
    {
      "id": "dns-names-dotted",
      "title": "Dotted to network",
      "operation": "DottedNameToNetwork",
      "cases": [
        {
          "key": "dns_dotted_short",
          "label": "Three labels"
        },
        {
          "key": "dns_dotted_max",
          "label": "253-byte maximum dotted name"
        },
        {
          "key": "dns_dotted_invalid",
          "label": "Empty interior label"
        },
        {
          "key": "dns_dotted_bytes",
          "label": "Embedded NUL / non-ASCII"
        },
        {
          "key": "dns_dotted_strict",
          "label": "Internet-hostname service"
        }
      ]
    },
    {
      "id": "dns-names-network",
      "title": "Network to dotted",
      "operation": "NetworkToDottedName",
      "cases": [
        {
          "key": "dns_network_root",
          "label": "Root only"
        },
        {
          "key": "dns_network_short",
          "label": "Three complete labels"
        },
        {
          "key": "dns_network_max",
          "label": "255-byte wire name"
        },
        {
          "key": "dns_network_truncated",
          "label": "Truncated second label"
        },
        {
          "key": "dns_network_oversize",
          "label": "64-byte label consumed then rejected"
        }
      ]
    },
    {
      "id": "dns-names-length",
      "title": "Length-prefixed readers",
      "operation": "ReadU8LengthPrefixed / ReadU16LengthPrefixed",
      "cases": [
        {
          "key": "dns_read_u8",
          "label": "U8 payload"
        },
        {
          "key": "dns_read_u16",
          "label": "U16 payload"
        },
        {
          "key": "dns_read_truncated",
          "label": "Truncated U16 payload"
        }
      ]
    },
    {
      "id": "dns-names-record",
      "title": "DNS record validation",
      "operation": "IsValidDnsRecordName",
      "cases": [
        {
          "key": "dns_record_valid",
          "label": "Service record name"
        },
        {
          "key": "dns_record_localhost",
          "label": "Localhost rejection"
        },
        {
          "key": "dns_record_ip",
          "label": "IPv6 URL hostname rejection"
        }
      ]
    },
    {
      "id": "dns-names-canonical-compare",
      "title": "Canonicalization and ordering",
      "operation": "UrlCanonicalizeNameIfAble / DomainNameComparator",
      "cases": [
        {
          "key": "dns_canonical_ascii",
          "label": "ASCII canonicalization"
        },
        {
          "key": "dns_canonical_unicode",
          "label": "IDNA canonicalization"
        },
        {
          "key": "dns_canonical_broken",
          "label": "Broken URL host fallback"
        },
        {
          "key": "dns_compare_ascii",
          "label": "ASCII case-insensitive comparator"
        },
        {
          "key": "dns_compare_bytes",
          "label": "Non-ASCII / NUL comparator"
        }
      ]
    }
  ]
}
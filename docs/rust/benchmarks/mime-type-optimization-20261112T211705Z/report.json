  "implemented_optimizations": [
    "Borrowed scalar offsets for MIME and parameter-free tokens, replacing owned Rust token byte vectors",
    "One final MIME parameter descriptor vector built directly by FFI; names/unchanged values borrow input by offset",
    "Shared transformed-byte scratch only for required unescaping or actual ASCII lowercase output",
    "Content-Type selects first requested parameters directly from the byte iterator without a full parameter vector",
    "Skip decoding/retaining unused or later duplicate Content-Type parameters",
    "Single Content-Type plan call with synchronous Rust-controlled lazy state getters; unchanged MIME does not materialize a normalized output",
    "C++ materializes final selected values once before any aliased output writes and commits in original mutation order"
  ],
  "policy_location": "All grammar, token validation, unescaping, ASCII normalization, first-parameter selection, alias-aware MIME equality, lazy state reads and charset retention/reset remain in safe Rust (mime_type_parser.rs forbids unsafe_code).",
  "ffi_safety": {
    "authored_unsafe": "Only unsafe extern C++ declarations for immutable, synchronous state getters; documented validity/lifetime contract. No handwritten Rust pointer arithmetic/dereference or uninitialized mutable outputs.",
    "state_getters": "C++ returns borrowed bytes or bool; no CxxString ABI crosses Cargo support library. No input/state borrow survives the FFI call.",
    "layouts": "Shared structs and opaque C++ state are generated by CXX; explicit field conversion between core and FFI avoids handwritten layout casts.",
    "alias_ownership": "C++ stages all selected strings/pairs before output writes; offsets remain valid across scratch-vector reallocations; commit order remains MIME then parameter vector, top then subtype, and boundary then MIME then charset."
  },

<!DOCTYPE html>
<html><head><title>Range CORS</title></head><body><p id="result">rustium-range-cors-ok</p>
            <script>Promise.all([
              fetch('http://127.0.0.1:63284/cors-valid',{headers:{Range:'bytes=0-3'}}).then(r=>r.text()),
              fetch('http://127.0.0.1:63284/cors-case',{headers:{Range:'Bytes=0-3'}}).then(r=>r.text())
            ]).then(v=>document.getElementById('result').textContent=
              v.join(',')==='RUST,RUST'?'rustium-range-cors-ok':'wrong-body')
              .catch(e=>document.getElementById('result').textContent=String(e));</script>
            </body></html>


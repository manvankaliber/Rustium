# Java tools are also used by desktop development tools and remote actions.
jdk_home = "//third_party/jdk/current"
if (host_os == "mac") {
  jdk_home += "/Contents/Home"
}

config("jdk") {
  include_dirs = [ "$jdk_home/include" ]
  if (host_os == "mac") {
    include_dirs += [ "$jdk_home/include/darwin" ]
  } else if (host_os == "win") {
    include_dirs += [ "$jdk_home/include/win32" ]
  } else {
    include_dirs += [ "$jdk_home/include/linux" ]
  }
}

group("java_data") {
  if (host_os == "win") {
    data = [
      "$jdk_home/bin/java.exe",
      "$jdk_home/bin/jcmd.exe",
    ]
  } else {
    data = [
      "$jdk_home/bin/java",
      "$jdk_home/bin/java.chromium",
      "$jdk_home/bin/jcmd",
    ]
  }
  data += [
    "//build/java_home.py",
    "$jdk_home/conf/",
    "$jdk_home/lib/",
  ]
}

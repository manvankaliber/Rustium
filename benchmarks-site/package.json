{
  "name": "rustium-benchmarks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "predev": "npm run sync",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run sync",
    "build": "vite build && npm run sync:check",
    "preview": "vite preview --host 127.0.0.1",
    "precheck": "npm run sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "pretest:data": "npm run sync",
    "test:data": "node scripts/check-data.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "7.3.8"
  }
}

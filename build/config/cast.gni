declare_args() {
  # Override the executable rpath; empty uses the default.
  target_rpath = ""
}

# Compatibility values for dependency build files. Cast device runtimes and
# renderer targets are retired. Desktop casting uses the media router.
is_castos = false
is_cast_android = false
enable_cast_receiver = false
enable_cast_renderer = false

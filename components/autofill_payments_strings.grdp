  <message name="IDS_AUTOFILL_CARD_BNPL_SUGGESTION_WITH_GOOGLE_PAY_IPH_BUBBLE_LABEL_DESKTOP_SCREENREADER" desc="Screenreader label for the `In-Product Help(IPH)` bubble to educate users that when using a BNPL suggestion, you can pay over time with Google Pay.">
      Buy now, pay later is available with Google Pay
  </message>

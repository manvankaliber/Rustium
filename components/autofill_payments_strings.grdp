  </message>
  <message name="IDS_AUTOFILL_WALLET_DIRECT_OFFERS_IPH_BUBBLE_LABEL_SCREENREADER" is_accessibility_with_no_ui="true" desc="Screenreader text for the IPH bubble for merchant promo code fields when direct offers from Google Wallet are available.">
    Select the promo code field to view and fill your saved offers
  </message>

    <message name="IDS_AUTOFILL_OFFERS_REMINDER_ICON_TOOLTIP_TEXT" desc="The tooltip text for the offer icon in the location bar.">
      Offer available
    </message>



  <if expr="toolkit_views">
    <message name="IDS_AUTOFILL_WALLET_DIRECT_OFFER_REMINDER_BODY_TEXT" desc="The body text of the bubble shown on the merchant website when an offer saved in the user's Google Wallet is available to use. It explains that the offer can be filled into the promo code field at checkout. The text between BEGIN_LINK and END_LINK is a link which opens a page describing the terms and conditions of the offer.">
      Your saved offer will be available at checkout using autofill. <ph name="BEGIN_LINK">$1</ph>View terms and conditions<ph name="END_LINK">$2</ph>
    </message>
  </if>


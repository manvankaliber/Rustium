import("//testing/test.gni")

static_library("common") {
  sources = [
    "language_detection_details.cc",
    "language_detection_details.h",
    "translate_constants.cc",
    "translate_constants.h",
    "translate_errors.h",
    "translate_features.cc",
    "translate_features.h",
    "translate_language_matcher.cc",
    "translate_language_matcher.h",
    "translate_metrics.cc",
    "translate_metrics.h",
    "translate_switches.cc",
    "translate_switches.h",
    "translate_util.cc",
    "translate_util.h",

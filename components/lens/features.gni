import("//build/config/chrome_build.gni")
import("//build/config/ui.gni")

import("//chrome/common/features.gni")

# Kept false for shared build manifests after platform retirement.
enable_android_lens_overlay = false

declare_args() {
  # Includes Lens features in the build. toolkit_views is used to ensure Lens
  # features are only included on Desktop devices running Chromium
  enable_lens_desktop = toolkit_views
}

declare_args() {
  # Lens features that are specific to the Google Chrome branded browser.
  # Features include:
  #  - Region Search
  #  - Side Panel
  #  - PDF Support
  enable_lens_desktop_google_branded_features =
      enable_lens_desktop && is_chrome_branded

  # Controls the inclusion of the Lens Overlay C++ backend.
  # This prevents many callsites from needing blocks checking both flags.
  enable_lens_overlay_backend = enable_lens_desktop
}

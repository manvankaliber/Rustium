# Generic asynchronous RPC helpers used by the Linux policy test server.
source_set("grpc") {
  testonly = true
  sources = [
    "cancellable_reactor.h",
    "grpc_call_options.cc",
    "grpc_call_options.h",
    "grpc_handler.cc",
    "grpc_handler.h",
    "grpc_server.cc",
    "grpc_server.h",
    "grpc_server_reactor.cc",
    "grpc_server_reactor.h",
    "grpc_status_or.cc",
    "grpc_status_or.h",
    "grpc_unary_handler.h",
    "server_reactor_tracker.cc",
    "server_reactor_tracker.h",
    "thread_safe_reactor_handle.h",
    "trackable_reactor.h",
  ]
  public_deps = [
    "//base",
    "//third_party/abseil-cpp:absl",
    "//third_party/grpc:grpc++",
  ]
  configs += [ "//build/config/compiler:wglobal_constructors" ]
}

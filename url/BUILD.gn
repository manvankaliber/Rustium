import("//build/buildflag_header.gni")
import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")
import("features.gni")

import("//build/config/cronet/config.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [ "USE_PLATFORM_ICU_ALTERNATIVES=$use_platform_icu_alternatives" ]
}

component("url") {
  sources = [
    "gurl.cc",
    "gurl.h",
    "gurl_debug.cc",
    "gurl_debug.h",
    "origin.cc",
    "origin.h",
    "origin_debug.cc",
    "origin_debug.h",
    "scheme_host_port.cc",
    "scheme_host_port.h",
    "third_party/mozilla/url_parse.cc",
    "third_party/mozilla/url_parse.h",
    "url_canon.cc",
    "url_canon.h",
    "url_canon_etc.cc",
    "url_canon_filesystemurl.cc",
    "url_canon_fileurl.cc",
    "url_canon_host.cc",
    "url_canon_internal.cc",
    "url_canon_internal.h",
    "url_canon_ip.cc",
    "url_canon_ip.h",
    "url_canon_mailtourl.cc",
    "url_canon_non_special_url.cc",
    "url_canon_path.cc",
    "url_canon_pathurl.cc",
    "url_canon_query.cc",
    "url_canon_relative.cc",
    "url_canon_stdstring.cc",
    "url_canon_stdstring.h",
    "url_canon_stdurl.cc",
    "url_constants.h",
    "url_features.cc",
    "url_features.h",
    "url_file.h",
    "url_parse_file.cc",
    "url_parse_internal.h",
    "url_util.cc",
    "url_util.h",
    "url_util_internal.h",
  ]

  defines = [ "IS_URL_IMPL" ]

  deps = []

  public_deps = [
    "//base",
    "//build:robolectric_buildflags",
    "//net:cronet_buildflags",
  ]

  if (is_win) {
    # Don't conflict with Windows' "url.dll".
    output_name = "url_lib"
  }

  # ICU support.
  if (use_platform_icu_alternatives) {
    assert(false,
           "ICU alternative is not implemented for platform: " + target_os)
  } else {
    # Use ICU.
    sources += [
      "url_canon_icu.cc",
      "url_canon_icu.h",
      "url_idna_icu.cc",
    ]
    deps += [
      "//base:i18n",
      "//third_party/icu",
    ]
  }
}

source_set("url_test_support") {
  testonly = true

  sources = [
    "gurl_abstract_tests.h",
    "origin_abstract_tests.cc",
    "origin_abstract_tests.h",
    "url_canon_icu_test_helpers.h",
  ]

  public_deps = [
    ":url",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]

  # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
  # enable the diagnostic by removing this line.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}

test("url_unittests") {
  sources = [
    "gurl_unittest.cc",
    "origin_unittest.cc",
    "run_all_unittests.cc",
    "scheme_host_port_unittest.cc",
    "url_canon_icu_unittest.cc",
    "url_canon_unittest.cc",
    "url_parse_unittest.cc",
    "url_test_utils.h",
    "url_util_unittest.cc",
  ]

  deps = [
    ":url",
    ":url_rust_unittests",
    ":url_test_support",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]

  if (enable_rust_api_from_cpp) {
    deps += [ ":url_rs_api_unittests" ]
  }

  if (use_platform_icu_alternatives) {
  } else {  # !use_platform_icu_alternatives
    deps += [ "//third_party/icu:icuuc" ]
  }

  if (!is_cronet_build) {
    sources += [
      "mojom/scheme_host_port_mojom_traits_unittest.cc",
      "mojom/url_gurl_mojom_traits_unittest.cc",
    ]
    deps += [
      "//mojo/core/embedder",
      "//mojo/public/cpp/test_support:test_utils",
      "//url/ipc:url_ipc_unittests",
      "//url/mojom:mojom_traits",
      "//url/mojom:test_url_mojom_gurl",
    ]
  }

  # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
  # enable the diagnostic by removing this line.
  configs += [ "//build/config/compiler:no_exit_time_destructors" ]
}

test("url_perftests") {
  sources = [
    "scheme_host_port_perftest.cc",
    "url_parse_perftest.cc",
  ]

  deps = [
    ":url",
    "//base",
    "//base/test:test_support",
    "//base/test:test_support_perf",
    "//testing/gtest",
    "//third_party/google_benchmark",
  ]
}

fuzzer_test("gurl_fuzzer") {
  sources = [ "gurl_fuzzer.cc" ]
  deps = [
    ":url",
    "//base",
    "//base:i18n",
    "//testing/libfuzzer:libfuzzer_base_wrappers",
  ]
  dict = "gurl_fuzzer.dict"
}

fuzzer_test("url_canon_icu_fuzzer") {
  sources = [ "url_canon_icu_fuzzer.cc" ]
  deps = [
    ":url",
    ":url_test_support",
    "//third_party/icu:icuuc",
  ]
}

# Provides FFI bindings for Chromium's C++ URL types (specifically GURL and
# url::Origin) using the cxx crate, enabling Rust code to interact with and use
# these types.
rust_static_library("url_rust") {
  crate_root = "url.rs"
  sources = [
    "gurl.rs",
    "origin.rs",
    "url.rs",
  ]
  allow_unsafe = true
  public_deps = [
    ":url",
    ":url_shim",
  ]
  deps = [ "//third_party/rust/cxx/v1:lib" ]
  cxx_bindings = [
    "gurl.rs",
    "origin.rs",
  ]
}

# Contains C++ shim code that supports the Rust FFI bindings for GURL and
# url::Origin. This is compiled as a separate C++ target to prevent exposing
# Rust-specific FFI shim functionality (such as shims returning rust::Str
# or FFI ordering functions) directly to general C++ users of the url library.
source_set("url_shim") {
  sources = [
    "gurl_shim.cc",
    "gurl_shim.h",
    "origin_shim.cc",
    "origin_shim.h",
  ]
  deps = [
    ":url",
    "//third_party/rust/cxx/v1:lib",
  ]
}

rust_static_library("url_rust_unittests") {
  testonly = true
  is_gtest_unittests = true
  sources = [ "gurl_unittest.rs" ]
  crate_root = "gurl_unittest.rs"
  deps = [
    ":url_rust",
    "//testing/rust_gtest_interop",
  ]
}

if (enable_rust_api_from_cpp) {
  import("//build/rust/rust_api_from_cpp.gni")

  # Rust bindings (generated by Crubit) for a subset of `//url` headers.
  rust_api_from_cpp("url_rs_api") {
    bindings_target = ":url"
    public_headers = [
      "gurl.h",
      "origin.h",
    ]
    root_namespaces = [ "url" ]

    # Limiting visibility, because certain foundational libraries (`//base`,
    # `//net`, `//url`, etc) can't use `rust_api_from_cpp` yet.  For more
    # details see the "Caveats" section in `//docs/rust/crubit/README.md`.
    #
    # TODO(https://crbug.com/576651451): Make publicly visible after Cronet
    # supports both Crubit directions.  Expand visibility as needed for
    # Crubit adopters outside of Cronet (e.g. `//content`).
    visibility = [ ":*" ]
  }

  rust_static_library("url_rs_api_unittests") {
    testonly = true
    is_gtest_unittests = true
    sources = [ "url_rs_api_unittest.rs" ]
    crate_root = "url_rs_api_unittest.rs"
    deps = [
      ":url_rs_api",
      "//build/rust/crubit:cpp_std",
      "//build/rust/crubit:ctor",
      "//testing/rust_gtest_interop",
    ]
  }
}
